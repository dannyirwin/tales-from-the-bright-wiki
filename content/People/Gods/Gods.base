filters:
  and:
    - file.hasTag("God")
properties:
  faction:
    displayName: Faction
  publish:
    displayName: Publish
views:
  - type: table
    name: Light
    filters:
      and:
        - faction == "Light"
    order:
      - file.name
      - faction
      - publish
  - type: table
    name: Void
    filters:
      and:
        - faction == "Void"
    order:
      - file.name
      - faction
      - publish
  - type: table
    name: Neutral
    filters:
      and:
        - faction == "Neutral"
    order:
      - file.name
      - faction
      - publish
  - type: table
    name: All gods
    order:
      - file.name
      - faction
      - publish
